[Desktop Entry]
Type=Application
Name=TabLink
GenericName=Tablet Link
Comment=Show and control your tablet on this laptop
Exec=tablink connect
Icon=tablink
Terminal=false
Categories=Utility;
Keywords=tablet;android;screen;mirror;scrcpy;redmi;wake;unlock;
StartupNotify=false
SingleMainWindow=true
Actions=WakeTablet;LaptopOnTablet;Setup;

[Desktop Action WakeTablet]
Name=Wake tablet
Exec=tablink wake

[Desktop Action LaptopOnTablet]
Name=Show laptop on tablet
Exec=tablink remote

[Desktop Action Setup]
Name=Set up tablet
Exec=tablink pair --gui
